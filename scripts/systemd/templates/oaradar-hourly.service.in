[Unit]
Description=OARadar hourly Pending and Done scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile={{ENV_FILE}}
Environment=OA_CONFIG={{CONFIG_PATH}}
# flock prevents a new scan from starting before the previous one finishes.
ExecStart=/usr/bin/flock -n %t/oaradar-hourly.lock {{PROJECT_ROOT}}/scripts/hourly-sync.sh
