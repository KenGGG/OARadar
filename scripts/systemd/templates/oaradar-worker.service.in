[Unit]
Description=OARadar OA operation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile={{ENV_FILE}}
ExecStart={{UV_BIN}} run oa worker --poll-seconds 2 --config {{CONFIG_PATH}}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
