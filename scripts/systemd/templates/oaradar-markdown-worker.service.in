[Unit]
Description=OARadar Markdown conversion worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{PROJECT_ROOT}}
Environment="PATH={{LIBREOFFICE_BIN}}:{{PROJECT_ROOT}}/.venv/bin:{{UV_BIN_DIR}}:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile={{ENV_FILE}}
ExecStart={{UV_BIN}} run oa markdown-worker --poll-seconds 2 --config {{CONFIG_PATH}}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
