[Unit]
Description=OARadar OA operation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/OARadar
EnvironmentFile=%h/.config/oaradar/env
ExecStart=%h/.local/bin/uv run oa worker --poll-seconds 2 --config config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
