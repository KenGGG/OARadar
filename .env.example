# Copy this file to .env and fill in your local OA origin.
# .env is ignored by Git. Never put real addresses or credentials in this example.
# Required: protocol, hostname and optional port only (no /seeyon suffix).
OA_BASE_URL=https://oa.example.invalid

# Seeyon application paths. Usually these defaults need no changes.
OA_CONTEXT_PATH=/seeyon
OA_LOGIN_PATH=/seeyon/index.jsp
OA_DONE_LIST_PATH="/seeyon/portalAffair/portalAffairController.do?method=moreDone"

# Do not store your password here. Use the local console's automatic-login
# form to save it in the current user's Windows Credential Manager.
