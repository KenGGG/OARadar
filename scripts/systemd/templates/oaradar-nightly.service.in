[Unit]
Description=OARadar nightly full Done-list reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile={{ENV_FILE}}
# The oneshot only enqueues; the single OA Worker owns the browser profile.
ExecStart=/usr/bin/flock -n %t/oaradar-nightly.lock {{UV_BIN}} run oa schedule enqueue nightly --config {{CONFIG_PATH}}
