[Unit]
Description=OARadar OA operation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{PROJECT_ROOT}}
Environment="PATH={{LIBREOFFICE_BIN}}:{{PROJECT_ROOT}}/.venv/bin:{{UV_BIN_DIR}}:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile={{ENV_FILE}}
ExecStart={{UV_BIN}} run oa worker --poll-seconds 2 --config {{CONFIG_PATH}}
Restart=always
RestartSec=5
NoNewPrivileges=true
# Chrome persistent profiles use /tmp for singleton/IPC state. A private
# namespace makes OA navigation fail with net::ERR_ACCESS_DENIED.
PrivateTmp=false
UMask=0077

[Install]
WantedBy=default.target
